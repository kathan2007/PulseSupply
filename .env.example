# ==========================================
# PulseSupply Global Environment Configuration
# ==========================================

# Database (PostgreSQL)
POSTGRES_USER=pulsegateway
POSTGRES_PASSWORD=pulsesupply_secure_pass_2026
POSTGRES_DB=pulsesupply_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://pulsegateway:pulsesupply_secure_pass_2026@postgres-db:5432/pulsesupply_db?schema=public

# Cache & Queues (Redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=pulsesupply_redis_auth_2026
REDIS_URL=redis://:pulsesupply_redis_auth_2026@redis:6379/0

# Order & Auth Service (Node.js/Express)
ORDER_SERVICE_PORT=4000
NODE_ENV=production
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_security
JWT_EXPIRES_IN=24h
ORDER_SERVICE_CORS_ORIGIN=*

# Analytics Service (Python FastAPI)
ANALYTICS_SERVICE_PORT=8000
PYTHON_ENV=production
LOG_LEVEL=INFO

# Gateway / Ingress (Nginx)
NGINX_PORT_HTTP=80
NGINX_PORT_HTTPS=443
DOMAIN_NAME=localhost

# Frontend
NEXT_PUBLIC_API_URL=/api

